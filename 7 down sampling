import pandas as pd
df = pd.read_csv("movies_updated.csv")
df["released"] = df["released"].str.extract(r"^(.{7}).*")[0]
df["Date"] = pd.to_datetime(df["released"], format="%B %d, %Y")
df.set_index("Date", inplace=True)
df.sort_index(inplace=True)
cols = ["score", "votes", "budget", "gross", "runtime"]
yearly_data = df[cols].resample("YE").mean().round(2)
print("Yearly Summary")
print(yearly_data.head(10))





